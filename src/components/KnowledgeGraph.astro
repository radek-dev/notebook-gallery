---
import { projects } from '../data/projects';

const technologies = [...new Set(projects.map((project) => project.technology))];
const topics = [...new Set(projects.flatMap((project) => project.topics))].sort();
const height = Math.max(technologies.length, projects.length, topics.length) * 80 + 100;
const columns = [
  { kind: 'technology', labels: technologies, x: 140 },
  { kind: 'project', labels: projects.map((project) => project.title), x: 480 },
  { kind: 'topic', labels: topics, x: 820 },
];
const nodes = columns.flatMap((column) => column.labels.map((label, i) => ({
  id: `${column.kind}:${label}`,
  label,
  kind: column.kind,
  x: column.x,
  y: 90 + i * (height - 160) / Math.max(column.labels.length - 1, 1),
  project: column.kind === 'project' ? projects.find((project) => project.title === label) : undefined,
})));
const edges = projects.flatMap((project) => [
  { source: `technology:${project.technology}`, target: `project:${project.title}` },
  ...project.topics.map((topic) => ({ source: `project:${project.title}`, target: `topic:${topic}` })),
]).map((edge) => ({
  ...edge,
  from: nodes.find((node) => node.id === edge.source)!,
  to: nodes.find((node) => node.id === edge.target)!,
}));
---

<section class="knowledge-graph" aria-labelledby="knowledge-graph">
  <h2 id="knowledge-graph">Knowledge graph</h2>
  <p>Select a technology or topic to highlight its projects. Project names open the content directly.</p>
  <div class="controls">
    <label>Find a connection <input type="search" placeholder="Try statistics or marimo" data-search /></label>
    <button type="button" data-reset>Reset graph</button>
    <span class="legend"><span class="technology-key">Technology</span> · <span class="project-key">Project</span> · <span class="topic-key">Topic</span></span>
  </div>
  <p class="status" aria-live="polite" data-status>All connections shown.</p>
  <div class="graph-scroll" tabindex="0" role="region" aria-label="Knowledge graph diagram; scroll horizontally on small screens">
    <svg viewBox={`0 0 960 ${height}`} aria-labelledby="graph-title graph-description">
      <title id="graph-title">Gallery projects, technologies and topics</title>
      <desc id="graph-description">Technologies on the left connect to projects in the middle and topics on the right. Use Tab to reach nodes, Enter to open projects, or Enter or Space to select a technology or topic. The text indexes below provide the same project links.</desc>
      {columns.map((column) => (
        <text class="column-label" x={column.x} y="30" text-anchor="middle">{column.kind === 'technology' ? 'TECHNOLOGIES' : column.kind === 'project' ? 'PROJECTS' : 'TOPICS'}</text>
      ))}
      {edges.map((edge) => (
        <path
          class="edge"
          data-source={edge.source}
          data-target={edge.target}
          d={`M ${edge.from.x + 120} ${edge.from.y} C ${edge.from.x + 170} ${edge.from.y}, ${edge.to.x - 170} ${edge.to.y}, ${edge.to.x - 120} ${edge.to.y}`}
        />
      ))}
      {nodes.map((node) => {
        const content = (
          <>
            <rect x={node.x - 120} y={node.y - 24} width="240" height="48" rx="12" />
            <text x={node.x} y={node.y} text-anchor="middle" dominant-baseline="central">{node.label}</text>
          </>
        );
        return node.project ? (
          <a
            class="node project"
            data-node={node.id}
            data-label={node.label}
            href={node.project.links.notebook ?? node.project.links.mathNote ?? node.project.links.app ?? node.project.links.source}
            aria-label={`Open ${node.label}`}
          ><title>{node.project.summary}</title>{content}</a>
        ) : (
          <g
            class={`node ${node.kind}`}
            data-node={node.id}
            data-label={node.label}
            role="button"
            tabindex="0"
            aria-pressed="false"
            aria-label={`Highlight projects connected to ${node.label}`}
          >{content}</g>
        );
      })}
    </svg>
  </div>
  <noscript>Enable JavaScript for highlighting and search. Project links and the text indexes below work without it.</noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.knowledge-graph').forEach((graph) => {
    const search = graph.querySelector<HTMLInputElement>('[data-search]')!;
    const status = graph.querySelector<HTMLElement>('[data-status]')!;
    const nodes = [...graph.querySelectorAll<SVGElement>('[data-node]')];
    const edges = [...graph.querySelectorAll<SVGPathElement>('[data-source]')];
    let selected: string | null = null;

    function update() {
      const query = search.value.trim().toLowerCase();
      const seeds = new Set(nodes.filter((node) =>
        selected ? node.dataset.node === selected : query && node.dataset.label!.toLowerCase().includes(query)
      ).map((node) => node.dataset.node!));
      const active = selected !== null || query !== '';
      const visible = new Set(seeds);
      for (const edge of edges) {
        if (seeds.has(edge.dataset.source!) || seeds.has(edge.dataset.target!)) {
          visible.add(edge.dataset.source!);
          visible.add(edge.dataset.target!);
        }
      }
      for (const node of nodes) {
        node.classList.toggle('muted', active && !visible.has(node.dataset.node!));
        node.classList.toggle('selected', seeds.has(node.dataset.node!));
        if (node.getAttribute('role') === 'button') {
          node.setAttribute('aria-pressed', String(node.dataset.node === selected));
        }
      }
      for (const edge of edges) {
        const highlighted = seeds.has(edge.dataset.source!) || seeds.has(edge.dataset.target!);
        edge.classList.toggle('muted', active && !highlighted);
        edge.classList.toggle('highlighted', active && highlighted);
      }
      const label = nodes.find((node) => node.dataset.node === selected)?.dataset.label;
      status.textContent = selected
        ? `Showing connections for ${label}. Select it again or reset to show all.`
        : query
          ? `${seeds.size} matching nodes for "${search.value.trim()}"; their direct connections are highlighted.`
          : 'All connections shown.';
    }

    for (const node of nodes.filter((node) => node.getAttribute('role') === 'button')) {
      const select = () => {
        selected = selected === node.dataset.node ? null : node.dataset.node!;
        search.value = '';
        update();
      };
      node.addEventListener('click', select);
      node.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          select();
        }
      });
    }
    search.addEventListener('input', () => { selected = null; update(); });
    graph.querySelector('[data-reset]')!.addEventListener('click', () => {
      selected = null;
      search.value = '';
      update();
    });
  });
</script>

<style>
  h2 { scroll-margin-top: 8rem; }
  .controls { display: flex; flex-wrap: wrap; gap: 1rem; align-items: end; }
  label { display: grid; gap: .25rem; font-size: .9rem; font-weight: 600; }
  input, button { font: inherit; padding: .55rem .8rem; border: 1px solid var(--border); border-radius: 8px; background: white; color: var(--fg); }
  button { cursor: pointer; }
  button:hover { background: var(--surface); }
  .legend { font-size: .85rem; padding-bottom: .6rem; }
  .technology-key { color: #1e40af; }
  .project-key { color: #065f46; }
  .topic-key { color: #6b21a8; }
  .status { min-height: 1.65em; font-size: .9rem; color: var(--muted); }
  .graph-scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: 16px; background: radial-gradient(ellipse at top, #eff6ff, #f8fafc 70%); }
  svg { display: block; width: 100%; min-width: 760px; }
  .column-label { fill: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: 2px; }
  .edge { fill: none; stroke: #94a3b8; stroke-width: 2; opacity: .55; }
  .edge.highlighted { stroke: #2563eb; stroke-width: 3; opacity: 1; }
  .node { cursor: pointer; }
  .node rect { stroke-width: 1.5; }
  .node text { font: 13px system-ui, sans-serif; font-weight: 600; fill: var(--fg); }
  .technology rect { fill: #dbeafe; stroke: #93c5fd; }
  .project rect { fill: #d1fae5; stroke: #6ee7b7; }
  .topic rect { fill: #f3e8ff; stroke: #d8b4fe; }
  .node:hover rect, .node.selected rect { stroke: #14213d; stroke-width: 3; }
  .node:focus-visible { outline: none; }
  .node:focus-visible rect { stroke: #1d4ed8; stroke-width: 4; }
  .node.muted { opacity: .3; }
  .edge.muted { opacity: .08; }
  .node, .edge { transition: opacity .15s ease; }
  @media (prefers-reduced-motion: reduce) { .node, .edge { transition: none; } }
</style>
