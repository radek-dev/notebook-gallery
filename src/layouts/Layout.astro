---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A portfolio of notebooks and apps.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/projects/`, label: 'Projects' },
  { href: `${base}/about/`, label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title} | Notebook Gallery</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a class="brand" href={`${base}/`}>Notebook Gallery</a>
      <nav aria-label="Main">
        {links.map((l) => (
          <a href={l.href} aria-current={Astro.url.pathname === l.href ? 'page' : undefined}>{l.label}</a>
        ))}
        <a href="https://github.com/radek-dev/notebook-gallery">GitHub repo</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>
        © {new Date().getFullYear()} ·
        <a href="https://github.com/radek-dev/notebook-gallery">Source on GitHub</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --fg: #1a2233;
    --muted: #5a6577;
    --accent: #1f5fbf;
    --border: #d9e0ec;
    --bg: #ffffff;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    line-height: 1.6;
    color: var(--fg);
    background: var(--bg);
  }
  a { color: var(--accent); }
  a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  header, main, footer { max-width: 64rem; margin: 0 auto; padding: 1rem; }
  header { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); }
  .brand { font-weight: 700; text-decoration: none; color: var(--fg); }
  nav { display: flex; gap: 1rem; }
  nav a[aria-current='page'] { font-weight: 700; }
  footer { color: var(--muted); border-top: 1px solid var(--border); margin-top: 2rem; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--bg); padding: .5rem; }
</style>
