---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A portfolio of notebooks and apps.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/projects/`, label: 'Projects' },
  { href: `${base}/about/`, label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title} | Notebook Gallery</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header"><div class="inner">
      <a class="brand" href={`${base}/`}>Notebook Gallery</a>
      <nav aria-label="Main">
        {links.map((l) => (
          <a href={l.href} aria-current={Astro.url.pathname === l.href ? 'page' : undefined}>{l.label}</a>
        ))}
        <a class="gh" href="https://github.com/radek-dev/notebook-gallery">GitHub repo</a>
      </nav>
    </div></header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>
        © {new Date().getFullYear()} ·
        <a href="https://github.com/radek-dev/notebook-gallery">Source on GitHub</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --fg: #14213d;
    --muted: #55607a;
    --accent: #1d4ed8;
    --accent-dark: #1e3a8a;
    --border: #e2e8f0;
    --surface: #f8fafc;
    --bg: #ffffff;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.65;
    color: var(--fg);
    background: var(--bg);
  }
  h1, h2, h3 { line-height: 1.2; letter-spacing: -0.01em; }
  h2 { font-size: 1.75rem; margin: 3rem 0 1.25rem; }
  a { color: var(--accent); }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .site-header { position: sticky; top: 0; z-index: 10; background: rgba(255, 255, 255, .95); border-bottom: 1px solid var(--border); backdrop-filter: blur(6px); }
  .site-header .inner, main, footer { max-width: 68rem; margin: 0 auto; padding: 1rem 1.25rem; }
  .site-header .inner { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; align-items: center; justify-content: space-between; }
  .brand { font-weight: 800; text-decoration: none; color: var(--fg); font-size: 1.1rem; }
  nav { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; align-items: center; }
  nav a { color: var(--muted); text-decoration: none; padding: .25rem 0; border-bottom: 2px solid transparent; }
  nav a:hover { color: var(--fg); }
  nav a[aria-current='page'] { color: var(--fg); font-weight: 600; border-bottom-color: var(--accent); }
  nav a.gh { border: 1px solid var(--border); border-radius: 999px; padding: .2rem .8rem; color: var(--fg); }
  nav a.gh:hover { background: var(--surface); }
  footer { color: var(--muted); border-top: 1px solid var(--border); margin-top: 4rem; font-size: .9rem; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--bg); padding: .5rem; z-index: 20; }
  .btn { display: inline-block; padding: .7rem 1.4rem; border-radius: 8px; font-weight: 600; text-decoration: none; border: 1px solid var(--accent); }
  .btn.primary { background: var(--accent); color: #fff; }
  .btn.primary:hover { background: var(--accent-dark); }
  .btn.secondary { color: var(--accent); background: #fff; }
  .btn.secondary:hover { background: var(--surface); }
</style>
