---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const steps = [
  { title: 'Explore', text: 'Browse projects with a clear question, approach and result for each.' },
  { title: 'Interact', text: 'Open marimo notebooks and Streamlit apps directly in your browser.' },
  { title: 'Inspect', text: 'Every project links to its open source code and data notes.' },
];
---

<Layout title="Home">
  <section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow">Data projects · Notebooks · Apps</p>
    <h1 id="hero-title">Interactive notebooks and apps, <span>explained.</span></h1>
    <p class="lead">
      A portfolio of data projects you can explore, run and inspect. Each project
      states the question it answers, how it was approached, and what its limits are.
    </p>
    <div class="actions">
      <a class="btn primary" href={`${base}/projects/`}>Browse projects</a>
      <a class="btn secondary" href="https://github.com/radek-dev/notebook-gallery">View on GitHub</a>
    </div>
  </section>

  <section aria-labelledby="how-title">
    <h2 id="how-title">How it works</h2>
    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="featured-title">
    <h2 id="featured-title">Featured projects</h2>
    <div class="grid">
      {projects.slice(0, 3).map((p) => <ProjectCard project={p} />)}
    </div>
    <p class="more"><a href={`${base}/projects/`}>See all projects →</a></p>
  </section>
</Layout>

<style>
  .hero { padding: 3.5rem 0 1.5rem; max-width: 46rem; }
  .eyebrow { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; margin: 0 0 .75rem; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 0 0 1rem; }
  h1 span { color: var(--accent); }
  .lead { font-size: 1.2rem; color: var(--muted); margin: 0 0 1.75rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .steps li { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; }
  .steps h3 { margin: .5rem 0 .25rem; }
  .steps p { margin: 0; color: var(--muted); }
  .num { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 700; }
  .grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); }
  .more { margin-top: 1.5rem; font-weight: 600; }
</style>
